{
  "name": "last-frontier-outbreak",
  "version": "15.0.0-alpha.1",
  "private": true,
  "scripts": {
    "build": "python3 scripts/build_release.py",
    "build:vite": "vite build && python3 scripts/package_vite.py",
    "test": "node --test tests/*.test.cjs",
    "test:release": "python3 -m unittest discover -s tests -p 'test_release.py' -v && python3 -m unittest discover -s tests -p 'test_preserve_pages.py' -v",
    "verify": "npm run test && npm run test:release && npm run build && npm run verify:dist",
    "verify:dist": "python3 scripts/package_dist.py --verify-only",
    "preview": "python3 -m http.server 4173 --bind 0.0.0.0 --directory dist"
  },
  "dependencies": {
    "pixi.js": "^8.22.0",
    "howler": "^2.2.4",
    "three": "0.170.0",
    "cannon-es": "0.20.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  }
}
